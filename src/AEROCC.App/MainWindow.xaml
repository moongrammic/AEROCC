<Window x:Class="AEROCC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AEROCC - Control Center"
        Width="390"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="#FF7014" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFA040" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorCircleStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                BorderBrush="#60FFFFFF"
                                BorderThickness="1.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="BorderThickness" Value="2.5" />
                                <Setter TargetName="circle" Property="BorderBrush" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#F418181C"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  Color="Black"
                                  Opacity="0.6"
                                  ShadowDepth="6"
                                  Direction="270" />
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Small orange logo -->
                        <Border Width="24" Height="24" CornerRadius="12" Background="#FF7014" Margin="0,0,8,0">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AEROCC" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Aero 16 1VH" FontSize="11" Foreground="#A0FFFFFF" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin button -->
                        <Button x:Name="PinButton" Click="PinButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand" Margin="0,0,4,0">
                            <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="15" Foreground="#70FFFFFF" />
                        </Button>
                        <!-- Close / Hide button -->
                        <Button Click="CloseButton_Click"
                                Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Foreground="#70FFFFFF" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Telemetry Cards (CPU, GPU, Fans) -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU Temp -->
                    <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="10" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Temperature24" FontSize="11" Foreground="#FF9933" Margin="0,0,3,0" />
                                <TextBlock Text="CPU" FontSize="10" Foreground="#88FFFFFF" />
                            </StackPanel>
                            <TextBlock x:Name="CpuTempText" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- GPU Temp -->
                    <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="10" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="DeviceEq24" FontSize="11" Foreground="#00E676" Margin="0,0,3,0" />
                                <TextBlock Text="GPU" FontSize="10" Foreground="#88FFFFFF" />
                            </StackPanel>
                            <TextBlock x:Name="GpuTempText" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Fan 1 (CPU) -->
                    <Border Grid.Column="4" Background="#14FFFFFF" CornerRadius="10" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="WeatherBlowingSnow24" FontSize="11" Foreground="#33C2FF" Margin="0,0,3,0" />
                                <TextBlock Text="Fan 1" FontSize="10" Foreground="#88FFFFFF" />
                            </StackPanel>
                            <TextBlock x:Name="Fan1RpmText" Text="-- RPM" FontSize="13" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Fan 2 (GPU) -->
                    <Border Grid.Column="6" Background="#14FFFFFF" CornerRadius="10" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="WeatherBlowingSnow24" FontSize="11" Foreground="#33C2FF" Margin="0,0,3,0" />
                                <TextBlock Text="Fan 2" FontSize="10" Foreground="#88FFFFFF" />
                            </StackPanel>
                            <TextBlock x:Name="Fan2RpmText" Text="-- RPM" FontSize="13" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Power & GPU Telemetry sub-line -->
                <Grid Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PowerInfoText" Text="⚡ Питание: --" FontSize="11" Foreground="#70FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="GpuDetailText" Text="RTX 5060: --" FontSize="11" Foreground="#70FFFFFF" VerticalAlignment="Center" />
                </Grid>

                <!-- Section: GPU Power Mode (PowerGear) -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="РЕЖИМ ВИДЕОКАРТЫ (POWERGEAR)" FontSize="11" FontWeight="Bold" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                    <Border Grid.Column="1" x:Name="GpuBadge" Background="#18FFFFFF" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock x:Name="GpuBadgeText" Text="Optimus" FontSize="10" Foreground="#00E676" />
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnGpuDynamic" Content="Dynamic" Style="{StaticResource SegmentButtonStyle}" Click="BtnGpuDynamic_Click" ToolTip="NVIDIA Optimus: автопереключение между Radeon и RTX" />
                    <Button Grid.Column="2" x:Name="BtnGpuEco" Content="Eco (Только iGPU)" Style="{StaticResource SegmentButtonStyle}" Click="BtnGpuEco_Click" ToolTip="Отключение питания RTX через ACPI для максимальной автономности" />
                    <Button Grid.Column="4" x:Name="BtnGpuPerformance" Content="dGPU Вкл" Style="{StaticResource SegmentButtonStyle}" Click="BtnGpuPerformance_Click" ToolTip="Дискретная RTX всегда активна (низкие задержки)" />
                </Grid>

                <!-- Section: Performance / Fan Profiles -->
                <TextBlock Text="РЕЖИМ ВЕНТИЛЯТОРОВ" FontSize="11" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,5" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnProfileEco" Content="Eco" Style="{StaticResource SegmentButtonStyle}" Click="BtnProfileEco_Click" />
                    <Button Grid.Column="2" x:Name="BtnProfileNormal" Content="Normal" Style="{StaticResource SegmentButtonStyle}" Click="BtnProfileNormal_Click" />
                    <Button Grid.Column="4" x:Name="BtnProfileGame" Content="Game" Style="{StaticResource SegmentButtonStyle}" Click="BtnProfileGame_Click" />
                    <Button Grid.Column="6" x:Name="BtnProfileTurbo" Content="Turbo" Style="{StaticResource SegmentButtonStyle}" Click="BtnProfileTurbo_Click" />
                </Grid>

                <!-- Section: Battery Charge Limit -->
                <TextBlock Text="ПОРОГ ЗАРЯДА БАТАРЕИ" FontSize="11" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,5" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnBattery60" Content="60%" Style="{StaticResource SegmentButtonStyle}" Click="BtnBattery60_Click" />
                    <Button Grid.Column="2" x:Name="BtnBattery80" Content="80% (Реком.)" Style="{StaticResource SegmentButtonStyle}" Click="BtnBattery80_Click" />
                    <Button Grid.Column="4" x:Name="BtnBattery100" Content="100%" Style="{StaticResource SegmentButtonStyle}" Click="BtnBattery100_Click" />
                </Grid>

                <!-- Section: Display Refresh Rate -->
                <TextBlock Text="ЧАСТОТА ЭКРАНА (IPS)" FontSize="11" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,5" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnRefresh60" Content="60 Гц (Батарея)" Style="{StaticResource SegmentButtonStyle}" Click="BtnRefresh60_Click" />
                    <Button Grid.Column="2" x:Name="BtnRefresh165" Content="165 Гц (Игры)" Style="{StaticResource SegmentButtonStyle}" Click="BtnRefresh165_Click" />
                </Grid>
                <CheckBox x:Name="AutoRefreshCheck" Content="Автопереключение (60 Гц от батареи / 165 Гц от сети)"
                          FontSize="11" Foreground="#99FFFFFF" Margin="2,0,0,10" Checked="AutoRefreshCheck_Changed" Unchecked="AutoRefreshCheck_Changed" />

                <!-- Section: Keyboard Backlight -->
                <TextBlock Text="ПОДСВЕТКА КЛАВИАТУРЫ" FontSize="11" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BacklightSlider" Minimum="0" Maximum="100" Value="100"
                            SmallChange="25" LargeChange="25"
                            ValueChanged="BacklightSlider_ValueChanged"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="BacklightPercentText" Text="100%" FontSize="12" Foreground="White"
                               Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>

                <!-- Quick colors palette -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Style="{StaticResource ColorCircleStyle}" Background="#FFFFFF" ToolTip="Белый" Click="ColorWhite_Click" />
                    <Button Style="{StaticResource ColorCircleStyle}" Background="#FF7014" ToolTip="AERO Orange" Click="ColorOrange_Click" />
                    <Button Style="{StaticResource ColorCircleStyle}" Background="#0099FF" ToolTip="Синий" Click="ColorBlue_Click" />
                    <Button Style="{StaticResource ColorCircleStyle}" Background="#FF3333" ToolTip="Красный" Click="ColorRed_Click" />
                    <Button Style="{StaticResource ColorCircleStyle}" Background="#00E676" ToolTip="Зеленый" Click="ColorGreen_Click" />
                    <Button Style="{StaticResource ColorCircleStyle}" Background="#9C27B0" ToolTip="Фиолетовый" Click="ColorPurple_Click" />
                    <Button Style="{StaticResource ColorCircleStyle}" ToolTip="Радуга / Неон" Click="EffectNeon_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0080" Offset="0" />
                                <GradientStop Color="#7928CA" Offset="0.5" />
                                <GradientStop Color="#00DFD8" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>

                <!-- Section: Hotkey Locks -->
                <Border Background="#12FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- WinKey Lock -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Foreground="#FFA040" Margin="0,0,6,0" />
                                <TextBlock Text="Блокировка клавиши Win" FontSize="12" Foreground="White" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="WinLockToggle" Click="WinLockToggle_Click" />
                        </Grid>

                        <Separator Background="#18FFFFFF" Margin="0,4" />

                        <!-- Fn Lock -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon x:Name="FnLockIcon" Symbol="Keyboard24" FontSize="14" Foreground="#33C2FF" Margin="0,0,8,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="FnLockLabel" Text="Режим F1–F12: Стандартные" FontSize="12" Foreground="White" />
                                    <TextBlock Text="Переключение: Fn + Esc" FontSize="10" Foreground="#60FFFFFF" />
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="FnLockToggle" Click="FnLockToggle_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Footer / Status & Quit -->
                <Grid Margin="2,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="IpcIndicator" Width="8" Height="8" Fill="#00E676" Margin="0,0,6,0" />
                        <TextBlock x:Name="IpcStatusText" Text="Служба активна (IPC)" FontSize="11" Foreground="#70FFFFFF" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="Выход" Click="QuitButton_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#60FFFFFF" FontSize="11" Cursor="Hand" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
