<Window x:Class="AEROCC.App.Views.ThermalMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AERO Thermal and Power Telemetry"
        Width="490"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="ApuPresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#28FFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="#00D4FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#80E5FF" />
                                <Setter Property="Foreground" Value="#FF0A1C25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#F418181C"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  Color="Black"
                                  Opacity="0.65"
                                  ShadowDepth="6"
                                  Direction="270" />
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2500D4FF" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="Pulse24" FontSize="18" Foreground="#00D4FF" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Тепловыделение и мощность" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" />
                            <TextBlock Text="AMD APU + NVIDIA RTX • Живая телеметрия" FontSize="10.5" Foreground="#80FFFFFF" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="1" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Foreground="#70FFFFFF" />
                    </Button>
                </Grid>

                <!-- 4 Metrics Cards (CPU, GPU, Fans, Power) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: CPU -->
                    <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="10" Padding="8,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <ui:SymbolIcon Symbol="Temperature24" FontSize="11" Foreground="#FF9933" Margin="0,0,4,0" />
                                <TextBlock Text="CPU" FontSize="10.5" FontWeight="SemiBold" Foreground="#A0FFFFFF" />
                            </StackPanel>
                            <TextBlock x:Name="CpuTempBig" Text="Нет данных" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" />
                            <TextBlock x:Name="CpuMinMaxText" Text="—" FontSize="9" Foreground="#70FFFFFF" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: GPU -->
                    <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="10" Padding="8,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="11" Foreground="#00E676" Margin="0,0,4,0" />
                                <TextBlock Text="GPU" FontSize="10.5" FontWeight="SemiBold" Foreground="#A0FFFFFF" />
                            </StackPanel>
                            <TextBlock x:Name="GpuTempBig" Text="44 °C" FontSize="16" FontWeight="Bold" Foreground="#00E676" />
                            <TextBlock x:Name="GpuStateText" Text="Active • 32W" FontSize="9" Foreground="#70FFFFFF" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Fan 1 (CPU) -->
                    <Border Grid.Column="4" Background="#14FFFFFF" CornerRadius="10" Padding="8,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <ui:SymbolIcon Symbol="WeatherBlowingSnow24" FontSize="11" Foreground="#40C4FF" Margin="0,0,4,0" />
                                <TextBlock Text="FAN 1" FontSize="10.5" FontWeight="SemiBold" Foreground="#A0FFFFFF" />
                            </StackPanel>
                            <TextBlock x:Name="Fan1RpmBig" Text="Нет данных" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" />
                            <TextBlock Text="CPU RPM" FontSize="9" Foreground="#70FFFFFF" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Fan 2 (GPU) -->
                    <Border Grid.Column="6" Background="#14FFFFFF" CornerRadius="10" Padding="8,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <ui:SymbolIcon Symbol="WeatherBlowingSnow24" FontSize="11" Foreground="#40C4FF" Margin="0,0,4,0" />
                                <TextBlock Text="FAN 2" FontSize="10.5" FontWeight="SemiBold" Foreground="#A0FFFFFF" />
                            </StackPanel>
                            <TextBlock x:Name="Fan2RpmBig" Text="Нет данных" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" />
                            <TextBlock Text="GPU RPM" FontSize="9" Foreground="#70FFFFFF" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Rolling Chart Container -->
                <Border Background="#0CFFFFFF"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,10,12,8"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Chart Legend & Title -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="ChartHeaderTitle" Text="ДИНАМИКА ТЕМПЕРАТУР И МОЩНОСТИ" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#FF9933" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="CPU °C" FontSize="10" Foreground="#C0FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />

                                <Border Width="8" Height="8" CornerRadius="4" Background="#00E676" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="GPU °C" FontSize="10" Foreground="#C0FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />

                                <Border Width="8" Height="8" CornerRadius="4" Background="#00D4FF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="GPU Вт" FontSize="10" Foreground="#C0FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />

                                <Border Width="8" Height="8" CornerRadius="4" Background="#FFD740" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Σ Вт" FontSize="10" Foreground="#C0FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Chart Canvas Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Y-Axis Labels (°C) -->
                            <Grid Grid.Column="0" Height="140">
                                <TextBlock Text="100°" FontSize="9" Foreground="#60FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                <TextBlock Text="75°" FontSize="9" Foreground="#60FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,32,4,0" />
                                <TextBlock Text="50°" FontSize="9" Foreground="#60FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,67,4,0" />
                                <TextBlock Text="25°" FontSize="9" Foreground="#60FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,102,4,0" />
                                <TextBlock Text="0°" FontSize="9" Foreground="#60FFFFFF" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,0" />
                            </Grid>

                            <!-- Center: Canvas + Time Axis -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Canvas Grid.Row="0" x:Name="ChartCanvas" Height="140" ClipToBounds="True" Background="#05FFFFFF" SizeChanged="ChartCanvas_SizeChanged">
                                    <!-- Horizontal Grid Lines -->
                                    <Line x:Name="GridLine0" X1="0" Y1="0" X2="350" Y2="0" Stroke="#12FFFFFF" StrokeDashArray="2,4" />
                                    <Line x:Name="GridLine1" X1="0" Y1="35" X2="350" Y2="35" Stroke="#12FFFFFF" StrokeDashArray="2,4" />
                                    <Line x:Name="GridLine2" X1="0" Y1="70" X2="350" Y2="70" Stroke="#12FFFFFF" StrokeDashArray="2,4" />
                                    <Line x:Name="GridLine3" X1="0" Y1="105" X2="350" Y2="105" Stroke="#12FFFFFF" StrokeDashArray="2,4" />
                                    <Line x:Name="GridLine4" X1="0" Y1="140" X2="350" Y2="140" Stroke="#25FFFFFF" />

                                    <!-- CPU Temp Line (Path with PathGeometry for gaps) -->
                                    <Path x:Name="CpuLine" Stroke="#FF9933" StrokeThickness="2" />

                                    <!-- GPU Temp Line (Path with PathGeometry for gaps) -->
                                    <Path x:Name="GpuLine" Stroke="#00E676" StrokeThickness="2" />

                                    <!-- GPU Power Line (Path with PathGeometry for gaps) -->
                                    <Path x:Name="PowerLine" Stroke="#00D4FF" StrokeThickness="1.5" StrokeDashArray="3,2" />

                                    <!-- Combined CPU+GPU Power Line (Path with PathGeometry for gaps) -->
                                    <Path x:Name="TotalPowerLine" Stroke="#FFD740" StrokeThickness="1.5" StrokeDashArray="4,2" />
                                </Canvas>

                                <!-- X-Axis Time Labels -->
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <TextBlock x:Name="TimeStartLabel" Text="—" FontSize="8.5" Foreground="#60FFFFFF" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="TimeMidLabel" Text="—" FontSize="8.5" Foreground="#60FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TimeEndLabel" Text="Сейчас" FontSize="8.5" Foreground="#60FFFFFF" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>

                            <!-- Right Y-Axis Labels (Watts: 0 - 160W) -->
                            <Grid Grid.Column="2" Height="140">
                                <TextBlock Text="160W" FontSize="9" Foreground="#7000D4FF" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4,0,0,0" />
                                <TextBlock Text="120W" FontSize="9" Foreground="#7000D4FF" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4,32,0,0" />
                                <TextBlock Text="80W" FontSize="9" Foreground="#7000D4FF" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4,67,0,0" />
                                <TextBlock Text="40W" FontSize="9" Foreground="#7000D4FF" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4,102,0,0" />
                                <TextBlock Text="0W" FontSize="9" Foreground="#7000D4FF" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="4,0,0,0" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AMD APU Power Tuning (SPL, sPPT, fPPT) -->
                <TextBlock Text="ЛИМИТЫ МОЩНОСТИ ПРОЦЕССОРА (AMD APU TDP)" FontSize="10.5" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnApuEco" Style="{StaticResource ApuPresetButtonStyle}" Click="BtnApuEco_Click" ToolTip="Эко: 28 Вт долговременная (тишина и автономность)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🍃 Eco APU" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="SPL 28W • fPPT 45W" FontSize="9.5" Foreground="#A0FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" x:Name="BtnApuBalanced" Style="{StaticResource ApuPresetButtonStyle}" Click="BtnApuBalanced_Click" ToolTip="Баланс: 45 Вт долговременная (заводской стандарт)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚖️ Баланс" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="SPL 45W • fPPT 65W" FontSize="9.5" Foreground="#A0FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" x:Name="BtnApuTurbo" Style="{StaticResource ApuPresetButtonStyle}" Click="BtnApuTurbo_Click" ToolTip="Турбо: 65 Вт долговременная (максимум для компиляции и рендеринга)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🚀 Турбо APU" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="SPL 65W • fPPT 85W" FontSize="9.5" Foreground="#A0FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Custom Slider for APU SPL -->
                <Border Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Пользовательский лимит SPL (долговременный TDP)" FontSize="11" Foreground="#C0FFFFFF" />
                                <TextBlock x:Name="SplValText" Text="45 Вт" FontSize="11" FontWeight="Bold" Foreground="#00D4FF" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SplSlider" Minimum="20" Maximum="80" Value="45" SmallChange="1" LargeChange="5"
                                    ValueChanged="SplSlider_ValueChanged" />
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="1" Click="ApplySpl_Click"
                                Background="#00D4FF" BorderThickness="0" Padding="12,6" Cursor="Hand" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Применить" FontSize="11" FontWeight="Bold" Foreground="#FF0A1C25" />
                        </Button>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="ApuStatusHintText"
                                   Text="Автоматический расчёт: SPL = 45W, sPPT = 54W, fPPT = 65W (ACPI SetApuPower)"
                                   FontSize="10" Foreground="#80FFFFFF" Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <!-- System Power Breakdown Card (CPU PKG, dGPU TGP, Battery, Total) -->
                <Border Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8"
                        ToolTip="CPU PKG: Windows Kernel RAPL (EMI); dGPU TGP: NVIDIA NVML; Батарея: ACPI BatteryStatus. На батарее 'Всего' отражает полный расход всего ноутбука.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CPU PKG" FontSize="9.5" Foreground="#70FFFFFF" />
                            <TextBlock x:Name="CpuWattsText" Text="--" FontSize="12.5" FontWeight="SemiBold" Foreground="#FF9933" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="dGPU TGP" FontSize="9.5" Foreground="#70FFFFFF" />
                            <TextBlock x:Name="GpuWattsText" Text="--" FontSize="12.5" FontWeight="SemiBold" Foreground="#00D4FF" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="БАТАРЕЯ" FontSize="9.5" Foreground="#70FFFFFF" />
                            <TextBlock x:Name="BatteryPowerText" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="#E0FFFFFF" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock x:Name="TotalPowerLabel" Text="CPU + GPU" FontSize="9.5" Foreground="#70FFFFFF" />
                            <TextBlock x:Name="TotalPowerText" Text="--" FontSize="12.5" FontWeight="Bold" Foreground="#FFD740" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU Detailed Telemetry Card -->
                <Border Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ЧАСТОТА dGPU" FontSize="9.5" Foreground="#70FFFFFF" />
                            <TextBlock x:Name="GpuClockText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ВИДЕОПАМЯТЬ VRAM" FontSize="9.5" Foreground="#70FFFFFF" />
                            <TextBlock x:Name="GpuVramText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ЗАГРУЗКА dGPU" FontSize="9.5" Foreground="#70FFFFFF" />
                            <TextBlock x:Name="GpuUsageText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#00E676" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
