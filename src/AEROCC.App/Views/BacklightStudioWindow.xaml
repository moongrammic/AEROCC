<Window x:Class="AEROCC.App.Views.BacklightStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AERO Fusion RGB Studio"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="OptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="#D0FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2EFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="#FF7014" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFA040" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.4" ShadowDepth="1" />
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="BorderThickness" Value="2.5" />
                                <Setter TargetName="circle" Property="BorderBrush" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="circle" Property="BorderThickness" Value="3" />
                                <Setter TargetName="circle" Property="BorderBrush" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#24FFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#F418181C"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  Color="Black"
                                  Opacity="0.65"
                                  ShadowDepth="6"
                                  Direction="270" />
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#25FF7014" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="Color24" FontSize="18" Foreground="#FF7014" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Студия подсветки" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" />
                            <TextBlock Text="AERO Fusion RGB • USB HID" FontSize="10.5" Foreground="#80FFFFFF" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="1" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Foreground="#70FFFFFF" />
                    </Button>
                </Grid>

                <!-- Interactive Keyboard Mockup Preview -->
                <Border x:Name="KeyboardPreviewBorder"
                        Background="#0DFFFFFF"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Stylized Keys Layout -->
                        <Grid Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="14" />
                            </Grid.RowDefinitions>

                            <!-- Row 1 (F-Keys) -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#30FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="2" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="4" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="6" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="8" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="10" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="12" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="14" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="16" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="18" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="20" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="22" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="24" Background="#30FFFFFF" CornerRadius="2" />
                            </Grid>

                            <!-- Row 2 (QWERTY) -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#25FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="2" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="4" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="6" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="8" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="10" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="12" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="14" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="16" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="18" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="20" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="22" Background="#25FFFFFF" CornerRadius="2" />
                            </Grid>

                            <!-- Row 3 (ASDF) -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#25FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="2" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="4" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="6" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="8" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="10" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="12" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="14" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="16" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="18" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="20" Background="#28FF7014" CornerRadius="2" />
                            </Grid>

                            <!-- Row 4 (Spacebar & Modifiers) -->
                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="20" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="3*" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="18" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="18" /><ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#25FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="2" Background="#25FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="4" Background="#25FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="6" x:Name="SpacebarGlow" Background="#FF7014" CornerRadius="2">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="PreviewGlowEffect" BlurRadius="12" Color="#FF7014" Opacity="0.8" ShadowDepth="0" />
                                    </Border.Effect>
                                </Border>
                                <Border Grid.Column="8" Background="#25FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="10" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="12" Background="#20FFFFFF" CornerRadius="2" />
                                <Border Grid.Column="14" Background="#20FFFFFF" CornerRadius="2" />
                            </Grid>
                        </Grid>

                        <!-- Preview Status Text -->
                        <TextBlock x:Name="PreviewStatusText"
                                   Text="Статический • 100% • Чистый белый"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#C0FFFFFF"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Section: Lighting Effects -->
                <TextBlock Text="ЭФФЕКТ СВЕЧЕНИЯ" FontSize="10.5" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" x:Name="BtnEffStatic" Content="Статика" Style="{StaticResource OptionButtonStyle}" Click="EffButton_Click" Tag="Active" />
                    <Button Grid.Row="0" Grid.Column="2" x:Name="BtnEffBreathing" Content="Дыхание" Style="{StaticResource OptionButtonStyle}" Click="EffButton_Click" />
                    <Button Grid.Row="0" Grid.Column="4" x:Name="BtnEffWave" Content="Волна" Style="{StaticResource OptionButtonStyle}" Click="EffButton_Click" />
                    <Button Grid.Row="0" Grid.Column="6" x:Name="BtnEffNeon" Content="Неон" Style="{StaticResource OptionButtonStyle}" Click="EffButton_Click" />

                    <Button Grid.Row="2" Grid.Column="0" x:Name="BtnEffSunset" Content="Закат" Style="{StaticResource OptionButtonStyle}" Click="EffButton_Click" />
                    <Button Grid.Row="2" Grid.Column="2" x:Name="BtnEffSunsetBreath" Content="Закат-Дых" Style="{StaticResource OptionButtonStyle}" Click="EffButton_Click" />
                    <Button Grid.Row="2" Grid.Column="4" x:Name="BtnEffSunsetNeon" Content="Закат-Неон" Style="{StaticResource OptionButtonStyle}" Click="EffButton_Click" />
                    <Button Grid.Row="2" Grid.Column="6" x:Name="BtnEffCustom" Content="Custom RGB" Style="{StaticResource OptionButtonStyle}" Click="EffButton_Click" />
                </Grid>

                <!-- Section: Colors -->
                <TextBlock Text="ЦВЕТОВАЯ ПАЛИТРА" FontSize="10.5" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Center">
                    <Button x:Name="BtnSwatchRainbow" Style="{StaticResource ColorSwatchStyle}" Click="SwatchRainbow_Click" ToolTip="🌈 Радуга (Все цвета спектра)">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0000" Offset="0" />
                                <GradientStop Color="#FF9900" Offset="0.2" />
                                <GradientStop Color="#33FF00" Offset="0.4" />
                                <GradientStop Color="#00FFFF" Offset="0.6" />
                                <GradientStop Color="#0066FF" Offset="0.8" />
                                <GradientStop Color="#CC00FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFFFFF" Click="Swatch_Click" ToolTip="Белый" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#00D4FF" Click="Swatch_Click" ToolTip="Ледяной синий" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#00E676" Click="Swatch_Click" ToolTip="Изумрудный зелёный" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFEB3B" Click="Swatch_Click" ToolTip="Жёлтый" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FF7014" Click="Swatch_Click" ToolTip="Фирменный AERO Оранжевый" Tag="Active" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FF2D55" Click="Swatch_Click" ToolTip="Красный" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#B388FF" Click="Swatch_Click" ToolTip="Фиолетовый" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FF4081" Click="Swatch_Click" ToolTip="Неоновый розовый" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#00BCD4" Click="Swatch_Click" ToolTip="Лазурный Cyan" />
                </WrapPanel>

                <!-- Custom RGB Sliders & Hex -->
                <Border x:Name="CustomRgbPanel" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- Red -->
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <TextBlock Text="R" Foreground="#FF5252" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="SliderR" Minimum="0" Maximum="255" Value="255" ValueChanged="RgbSlider_ValueChanged" SmallChange="1" LargeChange="16" />
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderR, StringFormat={}{0:0}}" Foreground="#A0FFFFFF" FontSize="10.5" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Green -->
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <TextBlock Text="G" Foreground="#69F0AE" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="SliderG" Minimum="0" Maximum="255" Value="112" ValueChanged="RgbSlider_ValueChanged" SmallChange="1" LargeChange="16" />
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderG, StringFormat={}{0:0}}" Foreground="#A0FFFFFF" FontSize="10.5" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Blue -->
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <TextBlock Text="B" Foreground="#448AFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="SliderB" Minimum="0" Maximum="255" Value="20" ValueChanged="RgbSlider_ValueChanged" SmallChange="1" LargeChange="16" />
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderB, StringFormat={}{0:0}}" Foreground="#A0FFFFFF" FontSize="10.5" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- Swatch Box & Hex Input -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border x:Name="ColorPreviewBox" Width="36" Height="36" CornerRadius="8" Background="#FF7014" BorderBrush="#50FFFFFF" BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#FF7014" Opacity="0.5" ShadowDepth="0" />
                                </Border.Effect>
                            </Border>
                            <TextBlock x:Name="HexPreviewText" Text="#FF7014" FontSize="9.5" Foreground="#A0FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamics: Brightness, Speed, Direction -->
                <TextBlock Text="ПАРАМЕТРЫ ДИНАМИКИ" FontSize="10.5" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Brightness -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Яркость" FontSize="11" Foreground="#C0FFFFFF" />
                            <TextBlock x:Name="BrightnessValText" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#FF7014" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="BrightnessSlider_ValueChanged" />
                    </StackPanel>

                    <!-- Speed -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Скорость эффекта" FontSize="11" Foreground="#C0FFFFFF" />
                            <TextBlock x:Name="SpeedValText" Text="5 / 10" FontSize="11" FontWeight="Bold" Foreground="#FF7014" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" ValueChanged="SpeedSlider_ValueChanged" />
                    </StackPanel>

                    <!-- Direction -->
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Направление анимации:" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="BtnDirLeft" Content="← Влево" Style="{StaticResource OptionButtonStyle}" Click="DirButton_Click" Tag="Active" Margin="0,0,6,0" Padding="10,4" />
                        <Button x:Name="BtnDirRight" Content="Вправо →" Style="{StaticResource OptionButtonStyle}" Click="DirButton_Click" Padding="10,4" />
                    </StackPanel>
                </Grid>

                <!-- Section: Presets -->
                <TextBlock Text="БЫСТРЫЕ ПРЕСЕТЫ" FontSize="10.5" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnPresetRainbow" Style="{StaticResource PresetCardStyle}" Click="PresetRainbow_Click" ToolTip="Бегущая радужная волна всех цветов">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Color24" FontSize="14" Foreground="#FF00E5" HorizontalAlignment="Center" />
                            <TextBlock Text="Радуга" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource PresetCardStyle}" Click="PresetOffice_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Lightbulb24" FontSize="14" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Офис" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource PresetCardStyle}" Click="PresetNight_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="14" Foreground="#FFA040" HorizontalAlignment="Center" />
                            <TextBlock Text="Ночь" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="6" Style="{StaticResource PresetCardStyle}" Click="PresetCyber_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="14" Foreground="#FF00AA" HorizontalAlignment="Center" />
                            <TextBlock Text="Неон" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="8" Style="{StaticResource PresetCardStyle}" Click="PresetOff_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Power24" FontSize="14" Foreground="#70FFFFFF" HorizontalAlignment="Center" />
