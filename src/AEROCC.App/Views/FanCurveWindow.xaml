<Window x:Class="AEROCC.App.Views.FanCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AERO Fan Curve Editor"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="FanPresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#28FFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="#00E676" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#69F0AE" />
                                <Setter Property="Foreground" Value="#FF102015" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#F418181C"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  Color="Black"
                                  Opacity="0.65"
                                  ShadowDepth="6"
                                  Direction="270" />
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2500E676" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="WeatherBlowingSnow24" FontSize="18" Foreground="#00E676" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Кривая скорости вентиляторов" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" />
                            <TextBlock Text="Программная кривая → 4 ступени EC (Eco / Normal / Game / Turbo)" FontSize="10.5" Foreground="#80FFFFFF" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="1" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Foreground="#70FFFFFF" />
                    </Button>
                </Grid>

                <!-- Live Status Banner -->
                <Border Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Temperature24" FontSize="13" Foreground="#FF9933" Margin="0,0,4,0" />
                            <TextBlock x:Name="CurrentTempText" Text="CPU: Нет данных" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,0,10,0" />
                            <ui:SymbolIcon Symbol="SoundWaveCircle24" FontSize="13" Foreground="#00E676" Margin="0,0,4,0" />
                            <TextBlock x:Name="CurrentRpmText" Text="Fan1: — • Fan2: — RPM" FontSize="12" Foreground="#C0FFFFFF" />
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="ProfileBadgeBorder" Background="#2000E676" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="ProfileStatusBadge" Text="Ступень EC неизвестна" FontSize="10.5" FontWeight="SemiBold" Foreground="#00E676" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Interactive Curve Chart Canvas Container -->
                <Border Background="#0CFFFFFF"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,10,14,10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Y-Axis Labels (0% to 100%) -->
                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="100%" FontSize="9.5" Foreground="#70FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,4,0" />
                            <TextBlock Text="75%" FontSize="9.5" Foreground="#70FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,45,4,0" />
                            <TextBlock Text="50%" FontSize="9.5" Foreground="#70FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,95,4,0" />
                            <TextBlock Text="25%" FontSize="9.5" Foreground="#70FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,145,4,0" />
                            <TextBlock Text="0%" FontSize="9.5" Foreground="#70FFFFFF" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,0" />
                        </Grid>

                        <!-- Chart Canvas -->
                        <Canvas Grid.Row="0" Grid.Column="1" x:Name="ChartCanvas" ClipToBounds="False" Background="#05FFFFFF"
                                MouseMove="ChartCanvas_MouseMove" MouseLeftButtonUp="ChartCanvas_MouseLeftButtonUp">
                            <!-- Background Grid Lines -->
                            <Line X1="0" Y1="0" X2="370" Y2="0" Stroke="#15FFFFFF" StrokeDashArray="2,4" />
                            <Line X1="0" Y1="50" X2="370" Y2="50" Stroke="#15FFFFFF" StrokeDashArray="2,4" />
                            <Line X1="0" Y1="100" X2="370" Y2="100" Stroke="#15FFFFFF" StrokeDashArray="2,4" />
                            <Line X1="0" Y1="150" X2="370" Y2="150" Stroke="#15FFFFFF" StrokeDashArray="2,4" />
                            <Line X1="0" Y1="200" X2="370" Y2="200" Stroke="#30FFFFFF" />

                            <!-- Vertical Temperature Lines -->
                            <Line X1="53" Y1="0" X2="53" Y2="200" Stroke="#10FFFFFF" StrokeDashArray="2,4" />
                            <Line X1="106" Y1="0" X2="106" Y2="200" Stroke="#10FFFFFF" StrokeDashArray="2,4" />
                            <Line X1="159" Y1="0" X2="159" Y2="200" Stroke="#10FFFFFF" StrokeDashArray="2,4" />
                            <Line X1="211" Y1="0" X2="211" Y2="200" Stroke="#10FFFFFF" StrokeDashArray="2,4" />
                            <Line X1="264" Y1="0" X2="264" Y2="200" Stroke="#10FFFFFF" StrokeDashArray="2,4" />
                            <Line X1="317" Y1="0" X2="317" Y2="200" Stroke="#10FFFFFF" StrokeDashArray="2,4" />

                            <!-- Shaded Area Below Curve -->
                            <Polygon x:Name="CurveAreaPolygon" Fill="#2000E676" />

                            <!-- Curve Polyline -->
                            <Polyline x:Name="CurvePolyline" Stroke="#00E676" StrokeThickness="2.5" />

                            <!-- Real-time Temperature Indicator Dot -->
                            <Ellipse x:Name="LiveTempMarker" Visibility="Collapsed" Width="10" Height="10" Fill="#FF7014" Stroke="#FFFFFFFF" StrokeThickness="1.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#FF7014" Opacity="0.9" ShadowDepth="0" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>

                        <!-- X-Axis Labels (30°C to 100°C) -->
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                            <TextBlock Text="30°C" FontSize="9.5" Foreground="#70FFFFFF" HorizontalAlignment="Left" />
                            <TextBlock Text="40°C" FontSize="9.5" Foreground="#70FFFFFF" HorizontalAlignment="Left" Margin="48,0,0,0" />
                            <TextBlock Text="50°C" FontSize="9.5" Foreground="#70FFFFFF" HorizontalAlignment="Left" Margin="101,0,0,0" />
                            <TextBlock Text="60°C" FontSize="9.5" Foreground="#70FFFFFF" HorizontalAlignment="Left" Margin="154,0,0,0" />
                            <TextBlock Text="70°C" FontSize="9.5" Foreground="#70FFFFFF" HorizontalAlignment="Left" Margin="206,0,0,0" />
                            <TextBlock Text="80°C" FontSize="9.5" Foreground="#70FFFFFF" HorizontalAlignment="Left" Margin="259,0,0,0" />
                            <TextBlock Text="90°C" FontSize="9.5" Foreground="#70FFFFFF" HorizontalAlignment="Left" Margin="312,0,0,0" />
                            <TextBlock Text="100°C" FontSize="9.5" Foreground="#70FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Points Chip Summary -->
                <TextBlock Text="КОНТРОЛЬНЫЕ ТОЧКИ КРИВОЙ (ТЕМПЕРАТУРА → ОБОРОТЫ)" FontSize="10.5" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,6" />
                <WrapPanel x:Name="PointsChipsPanel" Margin="0,0,0,10" HorizontalAlignment="Center">
                    <!-- Populated in code behind with 8 chips: e.g. "40°C: 25%" -->
                </WrapPanel>

                <!-- Presets -->
                <TextBlock Text="ПРЕСЕТЫ КРИВЫХ" FontSize="10.5" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnPresetSilent" Style="{StaticResource FanPresetButtonStyle}" Click="PresetSilent_Click" ToolTip="Тихий: шелест 15-20% при легкой нагрузке">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="LeafTwo24" FontSize="14" Foreground="#69F0AE" HorizontalAlignment="Center" />
                            <TextBlock Text="Тихий" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" x:Name="BtnPresetBalanced" Style="{StaticResource FanPresetButtonStyle}" Click="PresetBalanced_Click" ToolTip="Сбалансированный: заводской комфорт">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="DeviceEq24" FontSize="14" Foreground="#40C4FF" HorizontalAlignment="Center" />
                            <TextBlock Text="Баланс" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" x:Name="BtnPresetAggressive" Style="{StaticResource FanPresetButtonStyle}" Click="PresetAggressive_Click" ToolTip="Агрессивный: ранний выход на макс. обдув">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Rocket24" FontSize="14" Foreground="#FF9100" HorizontalAlignment="Center" />
                            <TextBlock Text="Турбо" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="6" x:Name="BtnPresetMax" Style="{StaticResource FanPresetButtonStyle}" Click="PresetMax_Click" ToolTip="Принудительный максимум: 100%">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="#FF5252" HorizontalAlignment="Center" />
                            <TextBlock Text="100% Max" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Fixed Fan Speed Section -->
                <TextBlock Text="ФИКСИРОВАННАЯ СКОРОСТЬ (АППАРАТНЫЕ СТУПЕНИ EC)" FontSize="9.5" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="FixedSpeedSlider" Minimum="20" Maximum="100" Value="60" SmallChange="5" LargeChange="10"
                            ToolTip="На EG61VH выбирает аппаратную ступень EC: 20-30% Eco, 31-59% Normal, 60-89% Game, 90-100% Turbo Max"
                            ValueChanged="FixedSpeedSlider_ValueChanged" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Click="ApplyFixedSpeed_Click"
                            Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1"
                            Padding="10,4" Cursor="Hand" Margin="8,0,0,0" ToolTip="Применить выбранную ступень EC (Eco / Normal / Game / Turbo)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="#00E676" Margin="0,0,4,0" />
                            <TextBlock x:Name="FixedSpeedBtnText" Text="Задать 60% (Game)" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Quick 4 EC Hardware Tiers Selection -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnTierEco" Style="{StaticResource FanPresetButtonStyle}" Click="FixedTierEco_Click" ToolTip="Ступень Eco (≤30%): тишина, остановка вентиляторов при низкой нагрузке">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Eco" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="25% • 0 RPM" FontSize="9" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" x:Name="BtnTierNormal" Style="{StaticResource FanPresetButtonStyle}" Click="FixedTierNormal_Click" ToolTip="Ступень Normal (50%): заводской сбалансированный режим">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Normal" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="50% • Баланс" FontSize="9" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" x:Name="BtnTierGame" Style="{StaticResource FanPresetButtonStyle}" Click="FixedTierGame_Click" ToolTip="Ступень Game (75%): повышенные обороты для охлаждения">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Game" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="75% • Игры" FontSize="9" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="6" x:Name="BtnTierTurbo" Style="{StaticResource FanPresetButtonStyle}" Click="FixedTierTurbo_Click" ToolTip="Ступень Turbo (100%): принудительный 100% максимальный обдув">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Turbo" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="100% • Макс" FontSize="9" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Bottom Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="ApplyCurveBtn" Click="ApplyCurve_Click"
                            Background="#00E676" BorderThickness="0" Padding="12,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" Foreground="#FF102518" Margin="0,0,6,0" />
                            <TextBlock x:Name="ApplyCurveBtnText" Text="Применить кривую" FontSize="12" FontWeight="Bold" Foreground="#FF102518" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Click="ResetDefault_Click"
                            Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="12,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="14" Foreground="#E0FFFFFF" Margin="0,0,6,0" />
                            <TextBlock Text="Сброс к стандарту" FontSize="12" FontWeight="SemiBold" Foreground="#E0FFFFFF" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
